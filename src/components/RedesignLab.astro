---
import ToolSearch from "@/components/ToolSearch";

export interface Props {
  direction: 1 | 2 | 3 | 4 | 5;
}

const { direction } = Astro.props;
const directionNames = ["Spotlight", "Terminal", "Grid", "Rail", "Palette"];
---

<a class="study-skip" href="#direction-content">Skip to content</a>

<div class:list={["study-shell", `study-direction-${direction}`]}>
  <header class="study-header">
    <a class="study-brand" href="/" translate="no">
      unwrapped<span class="study-brand-tld">.tools</span>
    </a>
    <span class="study-index">study {String(direction).padStart(2, "0")} / 05</span>
    <nav class="study-nav" aria-label="Design directions">
      {
        directionNames.map((name, index) => {
          const page = index + 1;
          return (
            <a
              href={`/${page}`}
              class:list={{ "is-current": page === direction }}
              aria-current={page === direction ? "page" : undefined}
              aria-label={`Direction ${page}: ${name}`}
              title={name}
            >
              {String(page).padStart(2, "0")}
            </a>
          );
        })
      }
    </nav>
  </header>

  <main id="direction-content" class="study-main" tabindex="-1">
    <section class="search-stage" aria-labelledby="direction-title">
      <h1 id="direction-title">Find a tool</h1>
      <ToolSearch client:load />
    </section>
  </main>
</div>

<style is="global">
  .study-shell {
    --study-bg: #080b0a;
    --study-panel: #101614;
    --study-panel-strong: #151e1a;
    --study-line: #24312b;
    --study-ink: #f0f5f1;
    --study-muted: #99a8a0;
    --study-faint: #607069;
    --study-accent: #78e2a4;
    --study-accent-soft: #244f38;
    min-height: 100dvh;
    background: var(--study-bg);
    color: var(--study-ink);
    color-scheme: dark;
    font-family: var(--font-sans);
  }

  .study-shell *,
  .study-shell *::before,
  .study-shell *::after {
    box-sizing: border-box;
  }

  .study-shell a {
    color: inherit;
  }

  .study-skip {
    position: fixed;
    z-index: 10;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--study-accent);
    border-radius: 0.35rem;
    background: var(--study-panel-strong);
    color: var(--study-ink);
    font-size: 0.78rem;
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .study-skip:focus {
    transform: translateY(0);
  }

  .study-header,
  .study-main {
    width: min(100% - 3rem, 1160px);
    margin-inline: auto;
  }

  .study-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
    border-bottom: 1px solid var(--study-line);
  }

  .study-brand {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .study-brand-tld {
    color: var(--study-accent);
  }

  .study-index,
  .study-nav {
    color: var(--study-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .study-index {
    justify-self: center;
  }

  .study-nav {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 0.35rem;
  }

  .study-nav a {
    display: inline-flex;
    min-width: 2rem;
    justify-content: center;
    padding: 0.4rem 0.25rem;
    border-bottom: 1px solid transparent;
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .study-nav a:hover,
  .study-nav a:focus-visible,
  .study-nav a.is-current {
    border-color: var(--study-accent);
    color: var(--study-accent);
  }

  .study-main {
    min-height: calc(100dvh - 4.75rem);
  }

  .search-stage > h1 {
    margin: 0;
    color: var(--study-ink);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .study-shell .lp {
    width: 100%;
  }

  .study-shell .lp-search {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 3.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--study-line);
    border-radius: 0.55rem;
    background: var(--study-panel);
    transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }

  .study-shell .lp-search:focus-within {
    border-color: var(--study-accent);
    background: var(--study-panel-strong);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--study-accent) 11%, transparent);
  }

  .study-shell .lp-search-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--study-muted);
  }

  .study-shell .lp-search-input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--study-ink);
    font: 0.95rem var(--font-sans);
  }

  .study-shell .lp-search-input::placeholder {
    color: var(--study-faint);
  }

  .study-shell .lp-search-clear {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--study-muted);
    cursor: pointer;
    font: 1.2rem/1 var(--font-sans);
  }

  .study-shell .lp-search-clear:hover {
    color: var(--study-ink);
  }

  .study-shell .lp-search-hint {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.25rem;
  }

  .study-shell .lp-search-hint kbd {
    min-width: 1.35rem;
    padding: 0.14rem 0.3rem;
    border: 1px solid var(--study-line);
    border-radius: 0.25rem;
    color: var(--study-faint);
    font: 0.62rem var(--font-mono);
    text-align: center;
  }

  .study-shell .lp-results {
    margin-top: 0.8rem;
  }

  .study-shell .lp-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    row-gap: 0.28rem;
    align-items: start;
    padding: 0.9rem 0.7rem;
    border-bottom: 1px solid var(--study-line);
    color: inherit;
    text-decoration: none;
    transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
  }

  .study-shell .lp-row:hover,
  .study-shell .lp-row--active {
    background: color-mix(in srgb, var(--study-accent) 8%, transparent);
  }

  .study-shell .lp-row-icon {
    display: flex;
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--study-line);
    border-radius: 0.38rem;
    color: var(--study-muted);
    transition: color 140ms ease, border-color 140ms ease, background-color 140ms ease;
  }

  .study-shell .lp-row-icon svg {
    width: 0.88rem;
    height: 0.88rem;
  }

  .study-shell .lp-row:where(:hover, .lp-row--active) .lp-row-icon {
    border-color: var(--study-accent-soft);
    background: var(--study-panel-strong);
    color: var(--study-accent);
  }

  .study-shell .lp-row-name {
    display: inline-flex;
    grid-column: 2;
    grid-row: 1;
    align-items: center;
    gap: 0.45rem;
    color: var(--study-ink);
    font-size: 0.9rem;
    font-weight: 650;
    transition: color 140ms ease;
  }

  .study-shell .lp-row:where(:hover, .lp-row--active) .lp-row-name {
    color: var(--study-accent);
  }

  .study-shell .lp-row-cat {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    color: var(--study-faint);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.04em;
    text-align: right;
    text-transform: lowercase;
  }

  .study-shell .lp-row-desc {
    grid-column: 2;
    grid-row: 2;
    color: var(--study-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .study-shell .lp-empty {
    margin: 1rem 0;
    color: var(--study-muted);
    font-size: 0.85rem;
  }

  /* 01. Spotlight. A single calm column with the search field as the anchor. */
  .study-direction-1 {
    --study-bg: #080b0a;
    --study-panel: #111815;
    --study-panel-strong: #17231c;
    --study-line: #25342c;
    --study-accent: #7be2a2;
    --study-accent-soft: #285d40;
    background:
      radial-gradient(circle at 50% 15%, rgba(55, 112, 78, 0.13), transparent 34rem),
      var(--study-bg);
  }

  .study-direction-1 .search-stage {
    width: min(100%, 760px);
    margin: 0 auto;
    padding-top: clamp(5rem, 17vh, 10rem);
  }

  .study-direction-1 .search-stage > h1 {
    margin-bottom: 2rem;
  }

  .study-direction-1 .lp-search {
    min-height: 4.25rem;
    padding-inline: 1.25rem;
    border-radius: 0.75rem;
  }

  .study-direction-1 .lp-search-input {
    font-size: 1.05rem;
  }

  .study-direction-1 .lp-results {
    margin-top: 1.2rem;
  }

  /* 02. Terminal. Dense rows, monospaced controls, no decorative framing. */
  .study-direction-2 {
    --study-bg: #0b0d10;
    --study-panel: #101419;
    --study-panel-strong: #171d24;
    --study-line: #27313a;
    --study-ink: #eaf0f3;
    --study-muted: #9aa8b0;
    --study-faint: #65727a;
    --study-accent: #8fd6ff;
    --study-accent-soft: #28506a;
  }

  .study-direction-2 .study-brand,
  .study-direction-2 .study-index,
  .study-direction-2 .study-nav,
  .study-direction-2 .search-stage > h1,
  .study-direction-2 .lp-search-input,
  .study-direction-2 .lp-row-cat {
    font-family: var(--font-mono);
  }

  .study-direction-2 .search-stage {
    width: min(100%, 980px);
    margin: 0 auto;
    padding-top: clamp(4rem, 12vh, 7rem);
  }

  .study-direction-2 .search-stage > h1 {
    margin-bottom: 1.75rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.07em;
  }

  .study-direction-2 .lp-search {
    border-radius: 0.2rem;
    background: transparent;
  }

  .study-direction-2 .lp-search:focus-within {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--study-accent) 12%, transparent);
  }

  .study-direction-2 .lp-row {
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    grid-template-rows: auto;
    align-items: center;
    padding-block: 0.72rem;
    border-bottom-color: color-mix(in srgb, var(--study-line) 80%, transparent);
  }

  .study-shell.study-direction-2 .lp-row-icon {
    grid-row: 1;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 0.2rem;
  }

  .study-shell.study-direction-2 .lp-row-name {
    grid-row: 1;
    font-size: 0.82rem;
    font-weight: 400;
  }

  .study-direction-2 .lp-row-desc {
    display: none;
  }

  .study-direction-2 .lp-row-cat {
    grid-row: 1;
  }

  /* 03. Grid. Icons carry the visual weight while search stays at the top. */
  .study-direction-3 {
    --study-bg: #0d0d0f;
    --study-panel: #151519;
    --study-panel-strong: #1b1b21;
    --study-line: #2b2b33;
    --study-ink: #f2f1f0;
    --study-muted: #a19ea5;
    --study-faint: #6e6a75;
    --study-accent: #f0b179;
    --study-accent-soft: #67452d;
  }

  .study-direction-3 .search-stage {
    width: min(100%, 1080px);
    margin: 0 auto;
    padding-top: clamp(4rem, 10vh, 7rem);
  }

  .study-direction-3 .search-stage > h1 {
    margin-bottom: 1.7rem;
  }

  .study-direction-3 .lp-search {
    max-width: 680px;
    border-radius: 0.3rem;
  }

  .study-direction-3 .lp-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .study-direction-3 .lp-row {
    display: flex;
    min-height: 11rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--study-line);
    border-radius: 0.65rem;
    background: var(--study-panel);
  }

  .study-direction-3 .lp-row:hover,
  .study-direction-3 .lp-row--active {
    border-color: var(--study-accent-soft);
    background: var(--study-panel-strong);
  }

  .study-shell.study-direction-3 .lp-row-icon {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.5rem;
  }

  .study-shell.study-direction-3 .lp-row-name,
  .study-shell.study-direction-3 .lp-row-desc,
  .study-shell.study-direction-3 .lp-row-cat {
    display: block;
    width: 100%;
  }

  .study-shell.study-direction-3 .lp-row-name {
    margin-top: 0.2rem;
  }

  .study-shell.study-direction-3 .lp-row-desc {
    margin-top: auto;
  }

  .study-shell.study-direction-3 .lp-row-cat {
    order: 3;
    color: var(--study-faint);
    text-align: left;
  }

  /* 04. Rail. The title stays quiet on the left while the tool list does the work. */
  .study-direction-4 {
    --study-bg: #090b0d;
    --study-panel: #11161b;
    --study-panel-strong: #182027;
    --study-line: #27343d;
    --study-ink: #edf2f3;
    --study-muted: #a0adb2;
    --study-faint: #68767c;
    --study-accent: #d4e875;
    --study-accent-soft: #52602c;
  }

  .study-direction-4 .search-stage {
    display: grid;
    grid-template-columns: minmax(12rem, 0.52fr) minmax(0, 1.48fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
    padding-top: clamp(5rem, 15vh, 9rem);
  }

  .study-direction-4 .search-stage > h1 {
    position: sticky;
    top: 2rem;
    max-width: 9rem;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
  }

  .study-direction-4 .lp-search {
    border-width: 0 0 1px;
    border-radius: 0;
    background: transparent;
    padding-inline: 0;
  }

  .study-direction-4 .lp-search:focus-within {
    box-shadow: none;
  }

  .study-direction-4 .lp-results {
    margin-top: 0.6rem;
  }

  .study-direction-4 .lp-row {
    padding-inline: 0;
    border-bottom-color: var(--study-line);
  }

  .study-direction-4 .lp-row:hover,
  .study-direction-4 .lp-row--active {
    background: transparent;
  }

  .study-direction-4 .lp-row:where(:hover, .lp-row--active) .lp-row-name {
    color: var(--study-accent);
  }

  /* 05. Palette. A focused panel for people who want a command-menu feel. */
  .study-direction-5 {
    --study-bg: #0a0a09;
    --study-panel: #151512;
    --study-panel-strong: #1d1d18;
    --study-line: #33332b;
    --study-ink: #f3f2e9;
    --study-muted: #aaa89a;
    --study-faint: #777568;
    --study-accent: #f0c674;
    --study-accent-soft: #6b582d;
    background:
      linear-gradient(135deg, rgba(86, 73, 33, 0.12), transparent 32rem),
      var(--study-bg);
  }

  .study-direction-5 .search-stage {
    width: min(100%, 900px);
    margin: 0 auto;
    padding: clamp(4rem, 13vh, 8rem) clamp(1rem, 4vw, 3rem) 3rem;
    border-inline: 1px solid color-mix(in srgb, var(--study-line) 65%, transparent);
  }

  .study-direction-5 .search-stage > h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
  }

  .study-direction-5 .lp-search {
    min-height: 4.5rem;
    padding-inline: 1.25rem;
    border-radius: 0.25rem;
    background: var(--study-panel-strong);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.24);
  }

  .study-direction-5 .lp-search-input {
    font-size: 1.05rem;
  }

  .study-direction-5 .lp-results {
    counter-reset: palette-row;
    margin-top: 1rem;
  }

  .study-direction-5 .lp-row {
    counter-increment: palette-row;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-rows: auto;
    align-items: center;
    padding-block: 0.75rem;
  }

  .study-direction-5 .lp-row::before {
    grid-column: 1;
    grid-row: 1;
    color: var(--study-faint);
    content: counter(palette-row, decimal-leading-zero);
    font: 0.65rem var(--font-mono);
  }

  .study-shell.study-direction-5 .lp-row-icon {
    display: none;
  }

  .study-shell.study-direction-5 .lp-row-name {
    grid-column: 2;
    grid-row: 1;
    font-weight: 550;
  }

  .study-shell.study-direction-5 .lp-row-desc {
    display: none;
  }

  .study-shell.study-direction-5 .lp-row-cat {
    grid-column: 3;
    grid-row: 1;
  }

  @media (max-width: 760px) {
    .study-header,
    .study-main {
      width: min(100% - 2rem, 1160px);
    }

    .study-header {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      min-height: 4.25rem;
    }

    .study-index {
      display: none;
    }

    .study-nav {
      gap: 0.1rem;
    }

    .study-nav a {
      min-width: 1.75rem;
      padding-inline: 0.15rem;
    }

    .study-main {
      min-height: calc(100dvh - 4.25rem);
    }

    .study-shell .lp-row {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 0.7rem;
      padding-inline: 0.25rem;
    }

    .study-shell .lp-row-cat {
      display: none;
    }

    .study-direction-1 .search-stage,
    .study-direction-2 .search-stage,
    .study-direction-3 .search-stage,
    .study-direction-5 .search-stage {
      padding-top: 4rem;
    }

    .study-direction-1 .search-stage > h1,
    .study-direction-2 .search-stage > h1,
    .study-direction-3 .search-stage > h1,
    .study-direction-5 .search-stage > h1 {
      margin-bottom: 1.4rem;
    }

    .study-direction-1 .lp-row-desc {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .study-direction-2 .lp-row {
      grid-template-rows: auto;
    }

    .study-direction-2 .lp-row-desc,
    .study-direction-2 .lp-row-cat {
      display: none;
    }

    .study-direction-3 .lp-results {
      grid-template-columns: 1fr;
    }

    .study-direction-3 .lp-row {
      min-height: 0;
    }

    .study-direction-4 .search-stage {
      display: block;
      padding-top: 4rem;
    }

    .study-direction-4 .search-stage > h1 {
      position: static;
      max-width: none;
      margin-bottom: 1.8rem;
    }

    .study-direction-5 .search-stage {
      padding-inline: 0.25rem;
      border-inline: 0;
    }

    .study-direction-5 .lp-row {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .study-direction-5 .lp-row::before {
      grid-column: 1;
    }

    .study-direction-5 .lp-row-name {
      grid-column: 2;
    }

    .study-direction-5 .lp-row-cat {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .study-shell a,
    .study-shell input,
    .study-shell .lp-row,
    .study-shell .lp-row-icon,
    .study-shell .lp-row-name,
    .study-shell .lp-search,
    .study-shell .study-nav a,
    .study-shell .study-skip {
      scroll-behavior: auto;
      transition: none;
    }
  }
</style>
