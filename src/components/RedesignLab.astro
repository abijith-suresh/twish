---
import { tools, type Tool } from "@/tools/registry";

export interface Props {
  direction: 1 | 2 | 3 | 4 | 5;
}

const { direction } = Astro.props;

function getTool(slug: string): Tool {
  const match = tools.find((candidate) => candidate.slug === slug);
  if (!match) {
    throw new Error(`Unknown design lab tool: ${slug}`);
  }
  return match;
}

const terminalTools = [
  getTool("json-formatter"),
  getTool("diff"),
  getTool("jwt-decoder"),
  getTool("regex-tester"),
  getTool("base64"),
  getTool("timestamp"),
];

const editorialTools = [
  getTool("json-formatter"),
  getTool("url-inspector"),
  getTool("hmac-generator"),
  getTool("case-converter"),
  getTool("cron"),
  getTool("http-status-codes"),
];

const swissTools = [
  getTool("json-formatter"),
  getTool("yaml-formatter"),
  getTool("xml-formatter"),
  getTool("json-to-csv"),
  getTool("diff"),
  getTool("base64"),
  getTool("jwt-decoder"),
  getTool("hash-generator"),
  getTool("regex-tester"),
  getTool("timestamp"),
  getTool("cron"),
  getTool("chmod-calculator"),
];

const observatoryTools = [
  getTool("jwt-decoder"),
  getTool("hmac-generator"),
  getTool("hash-generator"),
  getTool("token-generator"),
  getTool("url-inspector"),
  getTool("regex-tester"),
  getTool("diff"),
  getTool("cron"),
];

const benchTools = [
  getTool("base64"),
  getTool("json-to-yaml"),
  getTool("yaml-to-json"),
  getTool("case-converter"),
  getTool("uuid-generator"),
  getTool("text-statistics"),
  getTool("url-encoder"),
  getTool("chmod-calculator"),
];

const categoryLabels: Record<string, string> = {
  encoding: "Encoding",
  security: "Security",
  text: "Text",
  generators: "Generators",
  time: "Time",
  data: "Data",
  network: "Network",
};

const toolCount = tools.length;
const directionNames = ["Command deck", "Field notes", "The index", "Night shift", "Workbench"];
---

<a class="lab-skip" href="#direction-content">Skip to content</a>

<div class:list={["design-lab", `direction-${direction}`]}>
  <header class="lab-topbar">
    <a class="lab-brand" href="/" translate="no">
      <span class="lab-brand-mark">u/</span> unwrapped.tools
    </a>
    <span class="lab-study-label">design study {String(direction).padStart(2, "0")} / 05</span>
    <nav class="lab-direction-nav" aria-label="Design directions">
      {
        directionNames.map((name, index) => {
          const page = index + 1;
          return (
            <a
              class="lab-direction-link"
              class:list={{ "is-current": page === direction }}
              href={`/${page}`}
              aria-current={page === direction ? "page" : undefined}
              title={name}
            >
              <span>{String(page).padStart(2, "0")}</span>
            </a>
          );
        })
      }
    </nav>
  </header>

  <main id="direction-content" class="lab-main" tabindex="-1">
    {
      direction === 1 && (
        <div class="terminal-layout">
          <aside class="terminal-sidebar" aria-label="Workspace navigation">
            <p class="terminal-sidebar-label">workspace</p>
            <a class="terminal-nav-item is-selected" href="#terminal-tools">
              <span>&gt; all tools</span>
              <span>{toolCount}</span>
            </a>
            <a class="terminal-nav-item" href="/features">
              <span>&gt; catalog</span>
              <span>↗</span>
            </a>
            <a class="terminal-nav-item" href="/privacy">
              <span>&gt; privacy</span>
              <span>↗</span>
            </a>
            <div class="terminal-sidebar-rule" />
            <p class="terminal-sidebar-label">runtime</p>
            <p class="terminal-runtime">
              <span class="terminal-pulse" aria-hidden="true" />
              local / ready
            </p>
            <p class="terminal-sidebar-note">
              No request leaves this tab. The tools keep their hands off your data.
            </p>
          </aside>

          <section class="terminal-content" id="terminal-tools">
            <div class="terminal-kicker">01 / command deck</div>
            <h1>Keep the data here.</h1>
            <p class="terminal-intro">
              A quiet set of browser tools for the moments when copying a token into a random
              website feels like a bad idea.
            </p>

            <div class="terminal-command-line" data-tool-surface>
              <label class="sr-only" for="terminal-query">Find a tool</label>
              <span class="terminal-prompt" aria-hidden="true">&gt;_</span>
              <input
                id="terminal-query"
                data-tool-search
                type="search"
                placeholder="find a tool…"
                autocomplete="off"
              />
              <span class="terminal-shortcut">⌘ K</span>
            </div>
            <p class="terminal-result-count" data-search-count>{terminalTools.length} commands loaded</p>

            <div class="terminal-tool-list">
              {
                terminalTools.map((tool, index) => (
                  <a class="terminal-tool" data-tool-item href={`/tools/${tool.slug}`}>
                    <span class="terminal-tool-number">{String(index + 1).padStart(2, "0")}</span>
                    <span class="terminal-tool-copy">
                      <strong>{tool.name}</strong>
                      <span>{tool.description}</span>
                    </span>
                    <span class="terminal-tool-arrow" aria-hidden="true">↗</span>
                  </a>
                ))
              }
            </div>
            <p class="terminal-empty" data-search-empty hidden>No command found. Try “json” or “token”.</p>
          </section>

          <aside class="terminal-signal" aria-label="Local runtime status">
            <div class="terminal-signal-top">
              <span>signal</span>
              <span>01:00</span>
            </div>
            <div class="terminal-signal-display">
              <span class="terminal-signal-value">00</span>
              <span class="terminal-signal-unit">network requests</span>
            </div>
            <div class="terminal-wave" aria-hidden="true">
              <i /> <i /> <i /> <i /> <i /> <i /> <i /> <i /> <i /> <i /> <i />
            </div>
            <p class="terminal-signal-note">Nothing to phone home about.</p>
            <a class="terminal-text-link" href="/about">Read the contract <span>↗</span></a>
          </aside>
        </div>
      )
    }

    {
      direction === 2 && (
        <div class="editorial-layout">
          <div class="editorial-masthead">
            <span>unwrapped.tools / private utilities</span>
            <span>Vol. 01 · Browser edition</span>
          </div>
          <section class="editorial-hero">
            <div class="editorial-hero-copy">
              <p class="editorial-overline">Field notes for developers</p>
              <h1>Make room<br /><em>for the work.</em></h1>
              <p class="editorial-dek">
                Practical tools for tokens, text, configs, and time. They run beside you, not
                somewhere else.
              </p>
              <a class="editorial-button" href="#editorial-catalog">Browse the desk <span>↓</span></a>
            </div>
            <div class="editorial-feature-card">
              <div class="editorial-feature-top">
                <span>Editor's pick</span>
                <span>01 / 22</span>
              </div>
              <div class="editorial-feature-symbol" aria-hidden="true">{ }</div>
              <p class="editorial-feature-type">Data / formatting</p>
              <h2>{getTool("json-formatter").name}</h2>
              <p>{getTool("json-formatter").description}</p>
              <a href="/tools/json-formatter">Open formatter <span>↗</span></a>
            </div>
          </section>

          <section class="editorial-rule" id="editorial-catalog">
            <div>
              <p class="editorial-section-number">02</p>
              <h2>The desk</h2>
            </div>
            <p>
              A small collection of dependable instruments. Pick one, finish the job, close the
              tab.
            </p>
          </section>

          <div class="editorial-catalog">
            {
              editorialTools.map((tool, index) => (
                <a class="editorial-tool-card" href={`/tools/${tool.slug}`}>
                  <span class="editorial-tool-index">0{index + 1}</span>
                  <span class="editorial-tool-category">{categoryLabels[tool.category]}</span>
                  <h3>{tool.name}</h3>
                  <p>{tool.description}</p>
                  <span class="editorial-tool-open">Open tool ↗</span>
                </a>
              ))
            }
          </div>

          <footer class="editorial-footer">
            <p>Built for people who read the fine print.</p>
            <a href="/privacy">See what stays local <span>↗</span></a>
          </footer>
        </div>
      )
    }

    {
      direction === 3 && (
        <div class="swiss-layout">
          <div class="swiss-utility-bar">
            <span>UNWRAPPED / LOCAL COMPUTING INDEX</span>
            <span>09.09.26 / EDITION 01</span>
          </div>
          <section class="swiss-hero">
            <div class="swiss-hero-number">{toolCount}</div>
            <div class="swiss-hero-copy">
              <p class="swiss-overline">Developer tools without the detour</p>
              <h1>Useful things<br /><span>stay here.</span></h1>
              <p>
                Format, inspect, compare, generate. A compact local index for the small jobs that
                keep a build moving.
              </p>
            </div>
            <div class="swiss-hero-stamp">
              <span>RUNS</span>
              <strong>100%</strong>
              <span>IN BROWSER</span>
            </div>
          </section>

          <section class="swiss-index" aria-labelledby="swiss-index-title">
            <div class="swiss-index-heading">
              <span class="swiss-index-marker">A / 01</span>
              <h2 id="swiss-index-title">Tool index</h2>
              <span class="swiss-index-count">{toolCount} entries</span>
            </div>
            <div class="swiss-table-wrap">
              <table>
                <caption class="sr-only">Featured unwrapped.tools utilities</caption>
                <thead>
                  <tr>
                    <th scope="col">No.</th>
                    <th scope="col">Tool</th>
                    <th scope="col">Use it for</th>
                    <th scope="col">Open</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    swissTools.map((tool, index) => (
                      <tr>
                        <td class="swiss-table-number">{String(index + 1).padStart(2, "0")}</td>
                        <th scope="row"><a href={`/tools/${tool.slug}`}>{tool.name}</a></th>
                        <td>{tool.description}</td>
                        <td><a class="swiss-open" href={`/tools/${tool.slug}`} aria-label={`Open ${tool.name}`}>↗</a></td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </section>

          <section class="swiss-bottom-grid">
            <div class="swiss-principle">
              <span class="swiss-index-marker">B / 07</span>
              <p>“No server” is a product decision, not a marketing line.</p>
            </div>
            <div class="swiss-facts">
              <div><span>01</span><strong>No accounts</strong></div>
              <div><span>02</span><strong>No uploads</strong></div>
              <div><span>03</span><strong>No tracking</strong></div>
            </div>
          </section>
        </div>
      )
    }

    {
      direction === 4 && (
        <div class="observatory-layout">
          <div class="observatory-stars" aria-hidden="true" />
          <div class="observatory-heading-row">
            <span class="observatory-coordinates">51° 03′ 39″ N / 13° 44′ 22″ E</span>
            <span class="observatory-live"><i /> local signal active</span>
          </div>
          <section class="observatory-hero">
            <div class="observatory-hero-copy">
              <p class="observatory-overline">Night shift / tool observatory</p>
              <h1>A quiet place<br />for <em>noisy data.</em></h1>
              <p>
                Point your browser at the problem. Inspect the payload, tune the pattern, leave no
                trace.
              </p>
              <div class="observatory-actions">
                <a class="observatory-primary" href="/tools/jwt-decoder">Start with JWTs <span>↗</span></a>
                <a class="observatory-secondary" href="/about">Why local?</a>
              </div>
            </div>
            <div class="observatory-radar" aria-hidden="true">
              <div class="observatory-ring ring-one" />
              <div class="observatory-ring ring-two" />
              <div class="observatory-ring ring-three" />
              <div class="observatory-crosshair" />
              <div class="observatory-orbit-dot dot-one" />
              <div class="observatory-orbit-dot dot-two" />
              <span class="observatory-radar-label">LOCAL / 00:00</span>
            </div>
          </section>

          <section class="observatory-signal-panel" data-tool-surface>
            <div class="observatory-panel-heading">
              <div>
                <span class="observatory-panel-kicker">Incoming signals</span>
                <h2>Choose a frequency</h2>
              </div>
              <label class="observatory-search-label">
                <span class="sr-only">Search signals</span>
                <input data-tool-search type="search" placeholder="filter signals…" autocomplete="off" />
                <span aria-hidden="true">⌕</span>
              </label>
            </div>
            <div class="observatory-tool-grid">
              {
                observatoryTools.map((tool, index) => (
                  <a class="observatory-tool" data-tool-item href={`/tools/${tool.slug}`}>
                    <span class="observatory-tool-pulse" aria-hidden="true" />
                    <span class="observatory-tool-meta">0{index + 1} / {categoryLabels[tool.category]}</span>
                    <strong>{tool.name}</strong>
                    <span>{tool.description}</span>
                    <span class="observatory-tool-arrow" aria-hidden="true">↗</span>
                  </a>
                ))
              }
            </div>
            <p class="observatory-empty" data-search-empty hidden>No signal on that frequency.</p>
          </section>

          <footer class="observatory-footer">
            <span>unwrapped.tools / observation without collection</span>
            <a href="/privacy">Transmission log: empty ↗</a>
          </footer>
        </div>
      )
    }

    {
      direction === 5 && (
        <div class="bench-layout">
          <div class="bench-topline">
            <span class="bench-logo"><b>u</b> unwrapped.tools</span>
            <span class="bench-label">bench no. 05 / daily kit</span>
            <a href="/privacy">How the bench works ↗</a>
          </div>
          <section class="bench-hero">
            <div>
              <p class="bench-kicker">The browser workbench</p>
              <h1>Make the small<br /><span>jobs lighter.</span></h1>
              <p class="bench-lede">
                The useful little things you reach for between a terminal command and a code
                review.
              </p>
            </div>
            <div class="bench-badge">
              <span>LOCAL</span>
              <strong>ONLY</strong>
              <span>NO TRACKING</span>
            </div>
          </section>

          <section class="bench-board" aria-labelledby="bench-board-title">
            <div class="bench-board-head">
              <div>
                <span class="bench-index">01 / 04</span>
                <h2 id="bench-board-title">Today's tools</h2>
              </div>
              <a href="/features">See all {toolCount} tools ↗</a>
            </div>
            <div class="bench-tool-list">
              {
                benchTools.map((tool, index) => (
                  <a class="bench-tool-row" href={`/tools/${tool.slug}`}>
                    <span class="bench-tool-handle" aria-hidden="true">⠿</span>
                    <span class="bench-tool-number">0{index + 1}</span>
                    <span class="bench-tool-name">{tool.name}</span>
                    <span class="bench-tool-description">{tool.description}</span>
                    <span class="bench-tool-open" aria-hidden="true">↗</span>
                  </a>
                ))
              }
            </div>
          </section>

          <div class="bench-lower-grid">
            <section class="bench-shelf" aria-labelledby="bench-shelf-title">
              <div class="bench-shelf-head">
                <span class="bench-index">02 / 04</span>
                <h2 id="bench-shelf-title">The shelves</h2>
              </div>
              <div class="bench-category-grid">
                {
                  Array.from(new Set(tools.map((tool) => tool.category))).map((category, index) => (
                    <a href="/features" class="bench-category">
                      <span>0{index + 1}</span>
                      <strong>{categoryLabels[category]}</strong>
                      <small>{tools.filter((tool) => tool.category === category).length} tools</small>
                    </a>
                  ))
                }
              </div>
            </section>
            <aside class="bench-note">
              <span class="bench-note-pin" aria-hidden="true" />
              <span class="bench-note-label">Pinned note</span>
              <p>Paste the secret.<br />Do the work.<br />Close the tab.</p>
              <a href="/about">Read the promise ↗</a>
            </aside>
          </div>

          <footer class="bench-footer">
            <span>22 instruments / zero hand-offs</span>
            <a href="/">Return to the current app ↗</a>
          </footer>
        </div>
      )
    }
  </main>
</div>

<script>
  document.querySelectorAll("[data-tool-surface]").forEach((surface) => {
    const input = surface.querySelector<HTMLInputElement>("[data-tool-search]");
    if (!input) return;

    const root = surface.closest(".design-lab") ?? document;
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-tool-item]"));
    const count = root.querySelector<HTMLElement>("[data-search-count]");
    const empty = root.querySelector<HTMLElement>("[data-search-empty]");

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const match = !query || item.textContent.toLowerCase().includes(query);
        item.hidden = !match;
        if (match) visible += 1;
      });

      if (count) count.textContent = `${visible} ${visible === 1 ? "command" : "commands"} loaded`;
      if (empty) empty.hidden = visible !== 0;
    });
  });
</script>

<style>
  .design-lab {
    --lab-bg: #09090b;
    --lab-surface: #13141a;
    --lab-surface-strong: #1c1d26;
    --lab-ink: #e4e4e9;
    --lab-muted: #9498a5;
    --lab-faint: #5a5e6b;
    --lab-line: #27272a;
    --lab-accent: #34d399;
    min-height: 100dvh;
    overflow: hidden;
    background: var(--lab-bg);
    color: var(--lab-ink);
    font-family: var(--font-sans);
  }

  .lab-main,
  .lab-topbar {
    width: min(100% - 3rem, 1440px);
    margin-inline: auto;
  }

  .lab-topbar {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--lab-line) 85%, transparent);
  }

  .lab-brand,
  .lab-direction-link,
  .terminal-nav-item,
  .terminal-tool,
  .terminal-text-link,
  .editorial-button,
  .editorial-feature-card a,
  .editorial-tool-card,
  .editorial-footer a,
  .swiss-table a,
  .observatory-primary,
  .observatory-secondary,
  .observatory-tool,
  .observatory-footer a,
  .bench-topline a,
  .bench-board-head a,
  .bench-tool-row,
  .bench-category,
  .bench-note a,
  .bench-footer a {
    color: inherit;
    text-decoration: none;
  }

  .lab-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .lab-brand-mark {
    color: var(--lab-accent);
  }

  .lab-study-label {
    color: var(--lab-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lab-direction-nav {
    display: flex;
    justify-self: end;
    gap: 0.35rem;
  }

  .lab-direction-link {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--lab-line) 85%, transparent);
    color: var(--lab-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .lab-direction-link:hover,
  .lab-direction-link:focus-visible,
  .lab-direction-link.is-current {
    border-color: var(--lab-accent);
    background: color-mix(in srgb, var(--lab-accent) 14%, transparent);
    color: var(--lab-ink);
  }

  .lab-main {
    padding: clamp(3rem, 7vw, 7rem) 0 5rem;
  }

  .lab-skip {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-150%);
    padding: 0.7rem 0.9rem;
    background: var(--lab-accent, #34d399);
    color: #09090b;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .lab-skip:focus {
    transform: translateY(0);
  }

  .lab-main:focus {
    outline: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .design-lab input:focus-visible,
  .design-lab a:focus-visible {
    outline: 2px solid var(--lab-accent);
    outline-offset: 4px;
  }

  /* Direction 01: command deck */
  .direction-1 {
    --lab-bg: #090d0b;
    --lab-surface: #111813;
    --lab-surface-strong: #19231b;
    --lab-ink: #ecf7e8;
    --lab-muted: #9cab9d;
    --lab-faint: #66766a;
    --lab-line: #2a3a2e;
    --lab-accent: #b8f12f;
    --lab-warm: #ff9e55;
    background-color: var(--lab-bg);
    background-image: linear-gradient(rgba(184, 241, 47, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(184, 241, 47, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    font-family: var(--font-mono);
  }

  .direction-1 .lab-topbar {
    border-color: var(--lab-line);
  }

  .terminal-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) 15rem;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
  }

  .terminal-sidebar,
  .terminal-signal {
    color: var(--lab-muted);
    font-size: 0.7rem;
  }

  .terminal-sidebar-label,
  .terminal-kicker,
  .terminal-signal-top,
  .terminal-shortcut,
  .terminal-result-count,
  .terminal-tool-number,
  .terminal-tool-arrow {
    color: var(--lab-faint);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .terminal-sidebar-label {
    margin: 0 0 0.8rem;
  }

  .terminal-nav-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--lab-line) 60%, transparent);
    color: var(--lab-muted);
    transition: color 160ms ease;
  }

  .terminal-nav-item:hover,
  .terminal-nav-item.is-selected {
    color: var(--lab-accent);
  }

  .terminal-sidebar-rule {
    height: 1px;
    margin: 2rem 0;
    background: var(--lab-line);
  }

  .terminal-runtime {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--lab-ink);
  }

  .terminal-pulse,
  .observatory-live i,
  .observatory-tool-pulse {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--lab-accent);
    box-shadow: 0 0 0.8rem var(--lab-accent);
  }

  .terminal-sidebar-note {
    max-width: 13rem;
    margin: 1.4rem 0 0;
    color: var(--lab-faint);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .terminal-content {
    max-width: 46rem;
  }

  .terminal-kicker {
    margin-bottom: 1.25rem;
    color: var(--lab-accent);
  }

  .terminal-content h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--lab-ink);
    font-size: clamp(2.8rem, 7vw, 6.7rem);
    font-weight: 400;
    letter-spacing: -0.09em;
    line-height: 0.91;
  }

  .terminal-intro {
    max-width: 33rem;
    margin: 2rem 0 2.6rem;
    color: var(--lab-muted);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
  }

  .terminal-command-line {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-bottom: 1px solid var(--lab-accent);
    padding: 0.85rem 0;
  }

  .terminal-prompt {
    color: var(--lab-accent);
    font-weight: 700;
  }

  .terminal-command-line input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--lab-ink);
    font: inherit;
    font-size: 1rem;
  }

  .terminal-command-line input::placeholder {
    color: var(--lab-faint);
  }

  .terminal-shortcut {
    flex-shrink: 0;
    color: var(--lab-faint);
  }

  .terminal-result-count {
    margin: 0.85rem 0 0;
  }

  .terminal-tool-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--lab-line);
  }

  .terminal-tool {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--lab-line);
    transition: padding 160ms ease, color 160ms ease;
  }

  .terminal-tool:hover {
    padding-inline: 0.8rem;
    color: var(--lab-accent);
  }

  .terminal-tool-copy {
    display: grid;
    gap: 0.35rem;
  }

  .terminal-tool-copy strong {
    color: var(--lab-ink);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .terminal-tool:hover .terminal-tool-copy strong {
    color: var(--lab-accent);
  }

  .terminal-tool-copy span {
    color: var(--lab-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .terminal-tool-arrow {
    padding-top: 0.15rem;
  }

  .terminal-empty {
    padding: 2rem 0;
    color: var(--lab-warm);
    font-size: 0.75rem;
  }

  .terminal-signal {
    border-top: 1px solid var(--lab-line);
    border-bottom: 1px solid var(--lab-line);
    padding: 0.8rem 0 1.1rem;
  }

  .terminal-signal-top {
    display: flex;
    justify-content: space-between;
  }

  .terminal-signal-display {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 2.8rem 0 1.2rem;
  }

  .terminal-signal-value {
    color: var(--lab-accent);
    font-size: clamp(3.5rem, 6vw, 5rem);
    letter-spacing: -0.1em;
    line-height: 0.8;
  }

  .terminal-signal-unit {
    color: var(--lab-muted);
    font-family: var(--font-sans);
    font-size: 0.72rem;
  }

  .terminal-wave {
    display: flex;
    align-items: center;
    height: 3rem;
    gap: 0.2rem;
  }

  .terminal-wave i {
    display: block;
    width: 0.23rem;
    height: 30%;
    background: var(--lab-accent);
    animation: terminal-wave 1.8s ease-in-out infinite alternate;
  }

  .terminal-wave i:nth-child(2n) { height: 68%; animation-delay: -0.4s; }
  .terminal-wave i:nth-child(3n) { height: 45%; animation-delay: -0.8s; }
  .terminal-wave i:nth-child(5n) { height: 90%; animation-delay: -1.2s; }

  @keyframes terminal-wave {
    to { transform: scaleY(0.55); opacity: 0.45; }
  }

  .terminal-signal-note {
    margin: 0.6rem 0 2rem;
    color: var(--lab-faint);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .terminal-text-link {
    color: var(--lab-accent);
    font-size: 0.7rem;
  }

  /* Direction 02: editorial field notes */
  .direction-2 {
    --lab-bg: #f1eadc;
    --lab-surface: #1e3b59;
    --lab-surface-strong: #d8c9ad;
    --lab-ink: #17201f;
    --lab-muted: #68706a;
    --lab-faint: #9c988a;
    --lab-line: #c9bda7;
    --lab-accent: #d45a3b;
    --lab-blue: #1e3b59;
    color-scheme: light;
    background: var(--lab-bg);
    color: var(--lab-ink);
  }

  .direction-2 .lab-topbar {
    border-color: var(--lab-line);
  }

  .direction-2 .lab-brand-mark,
  .direction-2 .lab-direction-link.is-current,
  .direction-2 .lab-direction-link:hover,
  .direction-2 .lab-direction-link:focus-visible {
    color: var(--lab-accent);
  }

  .direction-2 .lab-direction-link.is-current,
  .direction-2 .lab-direction-link:hover,
  .direction-2 .lab-direction-link:focus-visible {
    border-color: var(--lab-accent);
    background: color-mix(in srgb, var(--lab-accent) 10%, transparent);
  }

  .editorial-layout {
    max-width: 78rem;
    margin-inline: auto;
  }

  .editorial-masthead,
  .editorial-footer,
  .editorial-rule,
  .editorial-tool-card,
  .editorial-feature-card {
    border-color: var(--lab-line);
  }

  .editorial-masthead,
  .editorial-footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--lab-line);
    padding: 0 0 0.8rem;
    color: var(--lab-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .editorial-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: clamp(2rem, 8vw, 10rem);
    align-items: end;
    padding: clamp(4rem, 9vw, 9rem) 0 clamp(4rem, 8vw, 8rem);
  }

  .editorial-overline,
  .editorial-section-number,
  .editorial-feature-type,
  .editorial-tool-category,
  .editorial-tool-index {
    color: var(--lab-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .editorial-overline {
    margin: 0 0 2rem;
  }

  .editorial-hero h1 {
    max-width: 8ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 10vw, 10rem);
    font-weight: 400;
    letter-spacing: -0.1em;
    line-height: 0.82;
  }

  .editorial-hero h1 em {
    color: var(--lab-accent);
    font-weight: 400;
  }

  .editorial-dek {
    max-width: 28rem;
    margin: 2.6rem 0 2rem;
    color: var(--lab-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .editorial-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--lab-ink);
    padding: 0.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .editorial-button:hover {
    border-color: var(--lab-accent);
    color: var(--lab-accent);
  }

  .editorial-feature-card {
    position: relative;
    overflow: hidden;
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--lab-blue);
    color: #f4efe4;
    padding: 1.3rem;
    transform: rotate(2deg);
  }

  .editorial-feature-card::before {
    position: absolute;
    top: 2rem;
    left: -2rem;
    content: "";
    width: 15rem;
    height: 15rem;
    border: 1px solid rgba(241, 234, 220, 0.26);
    border-radius: 50%;
    box-shadow: 0 0 0 2.5rem rgba(241, 234, 220, 0.04), 0 0 0 5rem rgba(241, 234, 220, 0.04);
  }

  .editorial-feature-top,
  .editorial-feature-type {
    position: relative;
    z-index: 1;
    color: #afc4d5;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .editorial-feature-top {
    position: absolute;
    top: 1.3rem;
    right: 1.3rem;
    left: 1.3rem;
    display: flex;
    justify-content: space-between;
  }

  .editorial-feature-symbol {
    position: absolute;
    top: 2.4rem;
    left: 1.5rem;
    color: #d9e8ee;
    font-family: Georgia, serif;
    font-size: 6rem;
    letter-spacing: -0.2em;
    opacity: 0.9;
  }

  .editorial-feature-card h2 {
    position: relative;
    z-index: 1;
    margin: 0.65rem 0 0.5rem;
    font-family: Georgia, serif;
    font-size: 2.1rem;
    font-weight: 400;
  }

  .editorial-feature-card > p:not(.editorial-feature-type) {
    position: relative;
    z-index: 1;
    margin: 0 0 1.4rem;
    color: #c1d0d5;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .editorial-feature-card a {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    border-bottom: 1px solid #f4efe4;
    padding-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .editorial-rule {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    border-top: 1px solid var(--lab-line);
    border-bottom: 1px solid var(--lab-line);
    padding: 1.25rem 0;
  }

  .editorial-rule h2 {
    margin: 0.45rem 0 0;
    font-family: Georgia, serif;
    font-size: 2.5rem;
    font-weight: 400;
  }

  .editorial-section-number {
    margin: 0;
  }

  .editorial-rule > p {
    align-self: end;
    max-width: 25rem;
    margin: 0;
    color: var(--lab-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .editorial-catalog {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 5rem;
    background: var(--lab-line);
    border: 1px solid var(--lab-line);
  }

  .editorial-tool-card {
    display: flex;
    min-height: 16rem;
    flex-direction: column;
    background: var(--lab-bg);
    padding: 1.35rem;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .editorial-tool-card:hover {
    background: #e4dac8;
  }

  .editorial-tool-index {
    color: var(--lab-muted);
  }

  .editorial-tool-category {
    margin-top: 2.6rem;
  }

  .editorial-tool-card h3 {
    margin: 0.55rem 0 0.5rem;
    font-family: Georgia, serif;
    font-size: 1.8rem;
    font-weight: 400;
  }

  .editorial-tool-card p {
    max-width: 18rem;
    margin: 0;
    color: var(--lab-muted);
    font-size: 0.83rem;
    line-height: 1.55;
  }

  .editorial-tool-open {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--lab-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .editorial-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--lab-line);
    border-bottom: 0;
    padding: 1rem 0 0;
  }

  .editorial-footer a {
    color: var(--lab-accent);
  }

  /* Direction 03: Swiss index */
  .direction-3 {
    --lab-bg: #e7e8e4;
    --lab-surface: #f5f5f1;
    --lab-surface-strong: #d7d9d2;
    --lab-ink: #121312;
    --lab-muted: #5d625c;
    --lab-faint: #888d86;
    --lab-line: #aeb2aa;
    --lab-accent: #ef3c2e;
    color-scheme: light;
    background: var(--lab-bg);
    color: var(--lab-ink);
    font-family: var(--font-sans);
  }

  .direction-3 .lab-topbar {
    width: min(100% - 3rem, 110rem);
    border-color: var(--lab-ink);
  }

  .direction-3 .lab-brand-mark,
  .direction-3 .lab-direction-link.is-current,
  .direction-3 .lab-direction-link:hover,
  .direction-3 .lab-direction-link:focus-visible {
    color: var(--lab-accent);
  }

  .direction-3 .lab-direction-link {
    border-color: var(--lab-ink);
  }

  .direction-3 .lab-direction-link.is-current,
  .direction-3 .lab-direction-link:hover,
  .direction-3 .lab-direction-link:focus-visible {
    border-color: var(--lab-accent);
    background: var(--lab-ink);
  }

  .swiss-layout {
    max-width: 110rem;
    margin-inline: auto;
  }

  .swiss-utility-bar,
  .swiss-index-heading,
  .swiss-table th,
  .swiss-table td,
  .swiss-index-marker,
  .swiss-index-count,
  .swiss-overline,
  .swiss-facts span {
    font-family: var(--font-mono);
  }

  .swiss-utility-bar {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--lab-ink);
    padding-bottom: 0.75rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .swiss-hero {
    display: grid;
    grid-template-columns: minmax(9rem, 0.4fr) minmax(0, 1fr) 15rem;
    gap: clamp(2rem, 5vw, 8rem);
    align-items: end;
    min-height: 29rem;
    border-bottom: 1px solid var(--lab-ink);
    padding: 4rem 0;
  }

  .swiss-hero-number {
    align-self: start;
    color: var(--lab-accent);
    font-family: var(--font-mono);
    font-size: clamp(8rem, 19vw, 22rem);
    font-weight: 700;
    letter-spacing: -0.16em;
    line-height: 0.65;
  }

  .swiss-hero-copy {
    max-width: 45rem;
  }

  .swiss-overline,
  .swiss-index-marker {
    color: var(--lab-accent);
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .swiss-hero h1 {
    margin: 1rem 0 1.8rem;
    font-size: clamp(3.7rem, 8vw, 8.8rem);
    font-weight: 800;
    letter-spacing: -0.1em;
    line-height: 0.82;
  }

  .swiss-hero h1 span {
    color: var(--lab-accent);
  }

  .swiss-hero-copy > p:last-child {
    max-width: 27rem;
    margin: 0;
    color: var(--lab-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .swiss-hero-stamp {
    display: grid;
    gap: 0.3rem;
    border: 1px solid var(--lab-ink);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .swiss-hero-stamp strong {
    font-size: 3.3rem;
    letter-spacing: -0.1em;
    line-height: 0.9;
  }

  .swiss-index {
    padding: 4rem 0 0;
  }

  .swiss-index-heading {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    border-bottom: 2px solid var(--lab-ink);
    padding-bottom: 0.8rem;
  }

  .swiss-index-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .swiss-index-marker {
    color: var(--lab-accent);
  }

  .swiss-index-count {
    color: var(--lab-muted);
    font-size: 0.65rem;
  }

  .swiss-table-wrap {
    overflow-x: auto;
  }

  .swiss-table {
    width: 100%;
    border-collapse: collapse;
  }

  .swiss-table th,
  .swiss-table td {
    border-bottom: 1px solid var(--lab-line);
    padding: 1rem 0.75rem;
    text-align: left;
    vertical-align: top;
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .swiss-table thead th {
    color: var(--lab-faint);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .swiss-table thead th:first-child,
  .swiss-table tbody td:first-child {
    padding-left: 0;
  }

  .swiss-table tbody th {
    width: 22%;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .swiss-table tbody td:nth-child(3) {
    width: 55%;
    color: var(--lab-muted);
    font-family: var(--font-sans);
  }

  .swiss-table-number {
    width: 5rem;
    color: var(--lab-accent);
  }

  .swiss-table a {
    transition: color 160ms ease;
  }

  .swiss-table a:hover {
    color: var(--lab-accent);
  }

  .swiss-open {
    color: var(--lab-accent);
    font-size: 1.1rem;
  }

  .swiss-bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 5rem;
    border-top: 1px solid var(--lab-ink);
    padding-top: 1rem;
  }

  .swiss-principle p {
    max-width: 28rem;
    margin: 2.5rem 0 0;
    font-size: clamp(1.8rem, 3vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.98;
  }

  .swiss-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    gap: 1rem;
  }

  .swiss-facts div {
    display: grid;
    gap: 0.8rem;
    border-top: 2px solid var(--lab-accent);
    padding-top: 0.7rem;
  }

  .swiss-facts span {
    color: var(--lab-accent);
    font-size: 0.62rem;
  }

  .swiss-facts strong {
    font-size: 0.8rem;
  }

  /* Direction 04: observatory */
  .direction-4 {
    --lab-bg: #080b20;
    --lab-surface: rgba(15, 21, 51, 0.72);
    --lab-surface-strong: #161e47;
    --lab-ink: #e9edff;
    --lab-muted: #a2acce;
    --lab-faint: #626d98;
    --lab-line: #293360;
    --lab-accent: #6ff6df;
    --lab-coral: #ff8068;
    background: radial-gradient(circle at 70% 15%, #1a2b5b 0, transparent 26rem),
      radial-gradient(circle at 15% 80%, #111841 0, transparent 28rem), var(--lab-bg);
    color: var(--lab-ink);
    font-family: var(--font-sans);
  }

  .direction-4 .lab-topbar {
    border-color: var(--lab-line);
  }

  .direction-4 .lab-brand-mark {
    color: var(--lab-accent);
  }

  .direction-4 .lab-direction-link.is-current,
  .direction-4 .lab-direction-link:hover,
  .direction-4 .lab-direction-link:focus-visible {
    border-color: var(--lab-accent);
    background: color-mix(in srgb, var(--lab-accent) 12%, transparent);
    color: var(--lab-accent);
  }

  .observatory-layout {
    position: relative;
    max-width: 92rem;
    margin-inline: auto;
  }

  .observatory-stars {
    position: absolute;
    inset: -7rem -10vw 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(233, 237, 255, 0.55) 0.7px, transparent 0.8px),
      radial-gradient(rgba(111, 246, 223, 0.35) 0.7px, transparent 0.8px);
    background-position: 0 0, 24px 38px;
    background-size: 73px 91px, 113px 137px;
    opacity: 0.3;
  }

  .observatory-heading-row,
  .observatory-hero,
  .observatory-signal-panel,
  .observatory-footer {
    position: relative;
    z-index: 1;
  }

  .observatory-heading-row,
  .observatory-footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    color: var(--lab-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .observatory-live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--lab-accent);
  }

  .observatory-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.75fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: center;
    padding: clamp(4rem, 9vw, 9rem) 0;
  }

  .observatory-overline,
  .observatory-panel-kicker,
  .observatory-tool-meta {
    color: var(--lab-coral);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .observatory-hero h1 {
    max-width: 11ch;
    margin: 1.6rem 0;
    font-size: clamp(3.9rem, 9vw, 8.7rem);
    font-weight: 300;
    letter-spacing: -0.09em;
    line-height: 0.86;
  }

  .observatory-hero h1 em {
    color: var(--lab-accent);
    font-style: normal;
  }

