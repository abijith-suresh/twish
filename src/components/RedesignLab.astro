---
import { tools, type Tool } from "@/tools/registry";

export interface Props {
  direction: 1 | 2 | 3 | 4 | 5;
}

const { direction } = Astro.props;

function getTool(slug: string): Tool {
  const match = tools.find((candidate) => candidate.slug === slug);
  if (!match) throw new Error(`Unknown design lab tool: ${slug}`);
  return match;
}

const directionNames = ["Plain list", "Sidebar", "Split view", "Card index", "Command line"];
const categoryLabels: Record<string, string> = {
  encoding: "Encoding",
  security: "Security",
  text: "Text",
  generators: "Generators",
  time: "Time",
  data: "Data",
  network: "Network",
};
const categories = Array.from(new Set(tools.map((tool) => tool.category)));
const selectedTool = getTool("json-formatter");
const featuredTools = [
  getTool("json-formatter"),
  getTool("diff"),
  getTool("base64"),
  getTool("jwt-decoder"),
];
---

<a class="quiet-skip" href="#direction-content">Skip to content</a>

<div class:list={["quiet-lab", `quiet-direction-${direction}`]}>
  <header class="quiet-header">
    <a class="quiet-brand" href="/" translate="no">unwrapped.tools</a>
    <span class="quiet-context">design study {String(direction).padStart(2, "0")} / 05</span>
    <div class="quiet-header-end">
      <span class="quiet-privacy">local only · no tracking</span>
      <nav class="quiet-direction-nav" aria-label="Design directions">
        {
          directionNames.map((name, index) => {
            const page = index + 1;
            return (
              <a
                href={`/${page}`}
                class:list={{ "is-current": page === direction }}
                aria-current={page === direction ? "page" : undefined}
                title={name}
              >
                {String(page).padStart(2, "0")}
              </a>
            );
          })
        }
      </nav>
    </div>
  </header>

  <main id="direction-content" class="quiet-main" tabindex="-1">
    {
      direction === 1 && (
        <section class="plain-list" data-quiet-surface>
          <div class="plain-list-intro">
            <div>
              <p class="quiet-eyebrow">Browser utilities</p>
              <h1>Find a tool.</h1>
            </div>
            <p class="plain-list-summary">{tools.length} focused tools. Search, open, work.</p>
          </div>

          <div class="plain-list-search">
            <label for="plain-list-query">Search tools</label>
            <input
              id="plain-list-query"
              data-quiet-search
              type="search"
              placeholder="Search by name or use…"
              autocomplete="off"
            />
            <span data-search-count>{tools.length} tools</span>
          </div>

          <ul class="plain-list-items">
            {
              tools.map((tool, index) => (
                <li>
                  <a class="plain-list-item" data-quiet-tool href={`/tools/${tool.slug}`}>
                    <span class="plain-list-number">{String(index + 1).padStart(2, "0")}</span>
                    <span class="plain-list-copy">
                      <strong>{tool.name}</strong>
                      <span>{tool.description}</span>
                    </span>
                    <span class="plain-list-category">{categoryLabels[tool.category]}</span>
                    <span class="plain-list-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="quiet-empty" data-search-empty hidden>No tools match that search.</p>
        </section>
      )
    }

    {
      direction === 2 && (
        <section class="sidebar-layout" data-quiet-surface>
          <aside class="sidebar-rail">
            <p class="quiet-eyebrow">Toolbox</p>
            <h1>Tools</h1>
            <p class="sidebar-note">Small utilities for text, data, secrets, and time.</p>
            <nav class="sidebar-categories" aria-label="Tool categories">
              <a class="is-active" href="#sidebar-all">All tools <span>{tools.length}</span></a>
              {
                categories.map((category) => (
                  <a href={`#sidebar-${category}`}>
                    {categoryLabels[category]} <span>{tools.filter((tool) => tool.category === category).length}</span>
                  </a>
                ))
              }
            </nav>
            <a class="sidebar-privacy" href="/privacy">How local storage works ↗</a>
          </aside>

          <div class="sidebar-workspace" id="sidebar-all">
            <div class="sidebar-workspace-head">
              <div>
                <p class="quiet-eyebrow">All tools</p>
                <h2>Choose one thing.</h2>
              </div>
              <label class="sidebar-search">
                <span class="sr-only">Filter tools</span>
                <input data-quiet-search type="search" placeholder="Filter…" autocomplete="off" />
                <span data-search-count>{tools.length}</span>
              </label>
            </div>

            <div class="sidebar-groups">
              {
                categories.map((category) => (
                  <section class="sidebar-group" id={`sidebar-${category}`}>
                    <h3>{categoryLabels[category]}</h3>
                    <div class="sidebar-group-items">
                      {
                        tools
                          .filter((tool) => tool.category === category)
                          .map((tool) => (
                            <a class="sidebar-tool" data-quiet-tool href={`/tools/${tool.slug}`}>
                              <strong>{tool.name}</strong>
                              <span>{tool.description}</span>
                              <span class="sidebar-tool-arrow" aria-hidden="true">↗</span>
                            </a>
                          ))
                      }
                    </div>
                  </section>
                ))
              }
            </div>
            <p class="quiet-empty" data-search-empty hidden>No tools match that search.</p>
          </div>
        </section>
      )
    }

    {
      direction === 3 && (
        <section class="split-layout" data-quiet-surface>
          <div class="split-picker">
            <div class="split-picker-head">
              <div>
                <p class="quiet-eyebrow">Tool picker</p>
                <h1>Pick a tool.</h1>
              </div>
              <span data-search-count>{tools.length} available</span>
            </div>
            <label class="split-search">
              <span class="sr-only">Search tools</span>
              <input data-quiet-search type="search" placeholder="Search tools…" autocomplete="off" />
            </label>
            <ul class="split-tool-list">
              {
                tools.map((tool, index) => (
                  <li>
                    <a
                      class:list={{ "split-tool": true, "is-featured": featuredTools.some((item) => item.id === tool.id) }}
                      data-quiet-tool
                      href={`/tools/${tool.slug}`}
                    >
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <strong>{tool.name}</strong>
                      <small>{categoryLabels[tool.category]}</small>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="quiet-empty" data-search-empty hidden>No tools match that search.</p>
          </div>

          <aside class="split-detail" aria-labelledby="selected-tool-title">
            <p class="quiet-eyebrow">Selected tool</p>
            <div class="split-detail-mark" aria-hidden="true">{ }</div>
            <h2 id="selected-tool-title">{selectedTool.name}</h2>
            <p class="split-detail-description">{selectedTool.description}</p>
            <a class="split-open" href={`/tools/${selectedTool.slug}`}>Open tool <span aria-hidden="true">↗</span></a>
            <dl class="split-facts">
              <div><dt>Runs</dt><dd>In your browser</dd></div>
              <div><dt>Input</dt><dd>Never uploaded</dd></div>
              <div><dt>Account</dt><dd>Not required</dd></div>
            </dl>
          </aside>
        </section>
      )
    }

    {
      direction === 4 && (
        <section class="card-index" data-quiet-surface>
          <div class="card-index-head">
            <div>
              <p class="quiet-eyebrow">unwrapped.tools</p>
              <h1>Useful things, kept close.</h1>
            </div>
            <p class="card-index-summary">No account. No server. No input history.</p>
          </div>

          <div class="card-index-controls">
            <label class="card-index-search">
              <span class="sr-only">Search tools</span>
              <input data-quiet-search type="search" placeholder="Search tools…" autocomplete="off" />
            </label>
            <span data-search-count>{tools.length} tools</span>
          </div>

          <div class="card-index-grid">
            {
              tools.map((tool, index) => (
                <a class="tool-card" data-quiet-tool href={`/tools/${tool.slug}`}>
                  <span class="tool-card-top"><span>{String(index + 1).padStart(2, "0")}</span><span>{categoryLabels[tool.category]}</span></span>
                  <strong>{tool.name}</strong>
                  <span>{tool.description}</span>
                  <span class="tool-card-arrow" aria-hidden="true">↗</span>
                </a>
              ))
            }
          </div>
          <p class="quiet-empty" data-search-empty hidden>No tools match that search.</p>
        </section>
      )
    }

    {
      direction === 5 && (
        <section class="command-layout" data-quiet-surface>
          <div class="command-bar">
            <a href="/" class="command-bar-brand" translate="no">unwrapped.tools</a>
            <span class="command-bar-status">local / ready</span>
            <a href="/privacy" class="command-bar-link">privacy ↗</a>
          </div>
          <div class="command-heading">
            <div>
              <p class="quiet-eyebrow">Tool command</p>
              <h1>What do you need?</h1>
            </div>
            <p>Type to filter. Press enter on a tool.</p>
          </div>
          <label class="command-input">
            <span aria-hidden="true">⌕</span>
            <span class="sr-only">Search tools</span>
            <input data-quiet-search type="search" placeholder="Search tools…" autocomplete="off" />
            <kbd>/</kbd>
          </label>
          <div class="command-list-head"><span>Tool</span><span data-search-count>{tools.length} results</span></div>
          <ul class="command-list">
            {
              tools.map((tool, index) => (
                <li>
                  <a class="command-item" data-quiet-tool href={`/tools/${tool.slug}`}>
                    <span class="command-item-index">{String(index + 1).padStart(2, "0")}</span>
                    <strong>{tool.name}</strong>
                    <span>{categoryLabels[tool.category]}</span>
                    <span class="command-item-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="quiet-empty" data-search-empty hidden>No tools match that search.</p>
          <div class="command-footer"><span>All processing stays in this tab.</span><a href="/about">About the project ↗</a></div>
        </section>
      )
    }
  </main>
</div>

<script>
  document.querySelectorAll("[data-quiet-surface]").forEach((surface) => {
    const input = surface.querySelector<HTMLInputElement>("[data-quiet-search]");
    if (!input) return;

    const root = surface.closest(".quiet-lab") ?? document;
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-quiet-tool]"));
    const counts = root.querySelectorAll<HTMLElement>("[data-search-count]");
    const empty = root.querySelector<HTMLElement>("[data-search-empty]");

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const match = !query || (item.textContent ?? "").toLowerCase().includes(query);
        item.hidden = !match;
        if (match) visible += 1;
      });

      counts.forEach((count) => {
        count.textContent = `${visible} ${visible === 1 ? "tool" : "tools"}`;
      });
      if (empty) empty.hidden = visible !== 0;
    });
  });
</script>

<style>
  .quiet-lab {
    --quiet-bg: #f4f4f1;
    --quiet-panel: #ffffff;
    --quiet-ink: #171918;
    --quiet-muted: #6b716d;
    --quiet-faint: #9da39e;
    --quiet-line: #d9ddd8;
    --quiet-accent: #247452;
    min-height: 100dvh;
    background: var(--quiet-bg);
    color: var(--quiet-ink);
    font-family: var(--font-sans);
  }

  .quiet-header,
  .quiet-main {
    width: min(100% - 3rem, 1180px);
    margin-inline: auto;
  }

  .quiet-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid var(--quiet-line);
    padding: 1.25rem 0;
  }

  .quiet-brand,
  .quiet-direction-nav a,
  .plain-list-item,
  .sidebar-categories a,
  .sidebar-privacy,
  .sidebar-tool,
  .split-tool,
  .split-open,
  .tool-card,
  .command-bar-brand,
  .command-bar-link,
  .command-item,
  .command-footer a {
    color: inherit;
    text-decoration: none;
  }

  .quiet-brand {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .quiet-context,
  .quiet-privacy,
  .quiet-direction-nav,
  .quiet-eyebrow,
  .plain-list-category,
  .plain-list-number,
  .sidebar-categories,
  .sidebar-group h3,
  .sidebar-search,
  .split-picker-head > span,
  .split-tool small,
  .card-index-controls,
  .tool-card-top,
  .command-bar,
  .command-list-head,
  .command-item-index,
  .command-footer {
    font-family: var(--font-mono);
  }

  .quiet-context,
  .quiet-privacy,
  .quiet-eyebrow,
  .quiet-direction-nav,
  .command-bar,
  .command-list-head,
  .command-footer {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quiet-context,
  .quiet-privacy {
    color: var(--quiet-muted);
  }

  .quiet-header-end {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 1.2rem;
  }

  .quiet-direction-nav {
    display: flex;
    gap: 0.25rem;
  }

  .quiet-direction-nav a {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid transparent;
    color: var(--quiet-faint);
    font-size: 0.62rem;
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }

  .quiet-direction-nav a:hover,
  .quiet-direction-nav a:focus-visible,
  .quiet-direction-nav a.is-current {
    border-color: var(--quiet-ink);
    background: var(--quiet-panel);
    color: var(--quiet-ink);
  }

  .quiet-main {
    padding: clamp(3.5rem, 7vw, 7rem) 0 5rem;
  }

  .quiet-skip {
    position: fixed;
    z-index: 20;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-150%);
    padding: 0.65rem 0.8rem;
    background: var(--quiet-ink, #171918);
    color: var(--quiet-bg, #f4f4f1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .quiet-skip:focus {
    transform: translateY(0);
  }

  .quiet-main:focus {
    outline: none;
  }

  .quiet-lab a:focus-visible,
  .quiet-lab input:focus-visible {
    outline: 2px solid var(--quiet-accent);
    outline-offset: 3px;
  }

  .quiet-eyebrow {
    margin: 0;
    color: var(--quiet-accent);
  }

  .quiet-empty {
    margin: 2rem 0;
    color: var(--quiet-muted);
    font-size: 0.86rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 01. Plain list */
  .quiet-direction-1 {
    --quiet-bg: #f3f4f0;
    --quiet-panel: #ffffff;
    --quiet-ink: #171918;
    --quiet-muted: #69716b;
    --quiet-faint: #a1a8a1;
    --quiet-line: #d7ddd7;
    --quiet-accent: #23734f;
    color-scheme: light;
  }

  .plain-list {
    max-width: 940px;
    margin-inline: auto;
  }

  .plain-list-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .plain-list h1,
  .sidebar-rail h1,
  .split-picker h1,
  .card-index h1,
  .command-heading h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.86;
  }

  .plain-list-summary {
    max-width: 12rem;
    margin: 0;
    color: var(--quiet-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .plain-list-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid var(--quiet-ink);
    padding: 0 0 0.8rem;
  }

  .plain-list-search label {
    color: var(--quiet-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .plain-list-search input,
  .sidebar-search input,
  .split-search input,
  .card-index-search input,
  .command-input input {
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--quiet-ink);
    font: inherit;
    font-size: 0.95rem;
  }

  .plain-list-search input::placeholder,
  .sidebar-search input::placeholder,
  .split-search input::placeholder,
  .card-index-search input::placeholder,
  .command-input input::placeholder {
    color: var(--quiet-faint);
  }

  .plain-list-search > span,
  .card-index-controls > span {
    color: var(--quiet-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .plain-list-items {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .plain-list-item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto 1rem;
    gap: 1rem;
    align-items: start;
    border-bottom: 1px solid var(--quiet-line);
    padding: 1.15rem 0;
    transition: padding 150ms ease, background-color 150ms ease;
  }

  .plain-list-item:hover {
    margin-inline: -0.75rem;
    padding-inline: 0.75rem;
    background: var(--quiet-panel);
  }

  .plain-list-number,
  .plain-list-category,
  .plain-list-arrow {
    color: var(--quiet-faint);
    font-size: 0.63rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .plain-list-copy {
    display: grid;
    gap: 0.4rem;
  }

  .plain-list-copy strong {
    font-size: 0.98rem;
    font-weight: 650;
  }

  .plain-list-copy span {
    color: var(--quiet-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .plain-list-category {
    padding-top: 0.15rem;
  }

  .plain-list-arrow {
    color: var(--quiet-accent);
    font-size: 0.9rem;
  }

  /* 02. Sidebar */
  .quiet-direction-2 {
    --quiet-bg: #111512;
    --quiet-panel: #171d18;
    --quiet-ink: #e8eee6;
    --quiet-muted: #9aa89d;
    --quiet-faint: #657269;
    --quiet-line: #2b372e;
    --quiet-accent: #a8d96f;
    background: var(--quiet-bg);
    color-scheme: dark;
  }

  .quiet-direction-2 .quiet-header {
    border-color: var(--quiet-line);
  }

  .quiet-direction-2 .quiet-direction-nav a:hover,
  .quiet-direction-2 .quiet-direction-nav a:focus-visible,
  .quiet-direction-2 .quiet-direction-nav a.is-current {
    border-color: var(--quiet-accent);
    background: var(--quiet-panel);
    color: var(--quiet-accent);
  }

  .quiet-direction-2 .quiet-skip {
    background: var(--quiet-accent);
    color: var(--quiet-bg);
  }

  .sidebar-layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    max-width: 1040px;
    margin-inline: auto;
  }

  .sidebar-rail {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .sidebar-rail h1 {
    color: var(--quiet-ink);
    font-size: clamp(3rem, 5vw, 4.8rem);
  }

  .sidebar-note {
    max-width: 12rem;
    margin: 1.6rem 0 2.5rem;
    color: var(--quiet-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .sidebar-categories {
    display: grid;
    gap: 0.25rem;
  }

  .sidebar-categories a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-left: 1px solid transparent;
    padding: 0.45rem 0.6rem;
    color: var(--quiet-muted);
    font-size: 0.7rem;
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }

  .quiet-direction-2 .sidebar-categories a:hover,
  .quiet-direction-2 .sidebar-categories a:focus-visible,
  .quiet-direction-2 .sidebar-categories a.is-active {
    border-color: var(--quiet-accent);
    background: var(--quiet-panel);
    color: var(--quiet-ink);
  }

  .sidebar-categories span {
    color: var(--quiet-faint);
  }

  .sidebar-privacy {
    display: inline-block;
    margin-top: 3rem;
    color: var(--quiet-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .sidebar-workspace-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--quiet-line);
    padding-bottom: 1.2rem;
  }

  .sidebar-workspace-head h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.07em;
  }

  .sidebar-search {
    display: flex;
    width: 11rem;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid var(--quiet-faint);
    padding: 0.5rem 0;
    color: var(--quiet-faint);
    font-size: 0.68rem;
  }

  .sidebar-search input {
    width: 100%;
    font-size: 0.78rem;
  }

  .sidebar-groups {
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
  }

  .sidebar-group h3 {
    margin: 0 0 0.65rem;
    color: var(--quiet-accent);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sidebar-group-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--quiet-line);
  }

  .sidebar-tool {
    position: relative;
    display: grid;
    gap: 0.4rem;
    min-height: 7rem;
    background: var(--quiet-bg);
    padding: 0.9rem;
    transition: background-color 150ms ease;
  }

  .sidebar-tool:hover {
    background: var(--quiet-panel);
  }

  .sidebar-tool strong {
    font-size: 0.88rem;
    font-weight: 600;
  }

