---
import Base from "@/layouts/Base.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const FOOTER_LINKS = [
  { href: "/about", label: "About" },
  { href: "/features", label: "Features" },
  { href: "/privacy", label: "Privacy" },
  {
    href: "https://github.com/abijith-suresh/unwrapped",
    label: "GitHub",
    external: true,
  },
];
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <a class="ls-skip-link" href="#main-content">Skip to content</a>

  <!-- One shared content rail keeps the header, page content, and footer aligned. -->
  <div class="ls-page">
    <header class="ls-header">
      <a class="ls-brand" href="/" translate="no">
        unwrapped<span class="ls-brand-tld">.tools</span>
      </a>
    </header>

    <main id="main-content" class="ls-main" tabindex="-1">
      <slot />
    </main>

    <footer class="ls-footer">
      <nav aria-label="Site navigation" class="ls-footer-nav">
        {
          FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              class="ls-footer-link"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</Base>

<style>
  /* One flex column and one source of horizontal padding for the landing shell. */
  .ls-page {
    --ls-content-max-width: 1120px;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-inline: clamp(1.25rem, 6vw, 7rem);
  }

  .ls-header,
  .ls-main,
  .ls-footer {
    width: min(100%, var(--ls-content-max-width));
    margin-inline: auto;
  }

  .ls-skip-link {
    position: fixed;
    z-index: 20;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--accent-primary);
    border-radius: 0.4rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.8rem;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 120ms ease;
  }

  .ls-skip-link:focus {
    transform: translateY(0);
  }

  .ls-header {
    display: flex;
    align-items: center;
    min-height: 4.25rem;
    border-bottom: 1px solid var(--border);
  }

  .ls-brand {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
  }

  .ls-brand-tld {
    color: var(--accent-primary);
  }

  .ls-main {
    flex: 1;
    padding-top: clamp(2rem, 5vh, 3.5rem);
  }

  .ls-footer {
    padding: 2.5rem 0 2.75rem;
    border-top: 1px solid var(--border);
  }

  .ls-footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  /* Footer link base styles */
  .ls-footer-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.1s;
  }

  .ls-footer-link:hover {
    color: var(--text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .ls-skip-link,
    .ls-footer-link {
      transition: none;
    }
  }
</style>
