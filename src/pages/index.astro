---
import LandingShell from "@/layouts/LandingShell.astro";
import ToolSearch from "@/components/ToolSearch";
---

<LandingShell title="unwrapped.tools">
  <div class="lp-home">
    <header class="lp-home-header">
      <a class="lp-home-brand" href="/" translate="no">
        unwrapped<span class="lp-home-brand-tld">.tools</span>
      </a>
      <h1 id="tool-search-title">Find a tool</h1>
    </header>

    <section class="lp-home-search" id="tool-search" aria-labelledby="tool-search-title">
      <ToolSearch client:load />
    </section>
  </div>
</LandingShell>

<!-- ToolSearch is a SolidJS island, so these styles must stay global. -->
<style is:global>
  .lp-home {
    --lp-home-surface: var(--bg-secondary);
    --lp-home-surface-hover: var(--bg-tertiary);
    --lp-home-border: var(--border);
    --lp-home-text: var(--text-primary);
    --lp-home-secondary: var(--text-secondary);
    --lp-home-muted: var(--text-muted);
    --lp-home-accent: var(--accent-primary);
    --lp-home-accent-soft: color-mix(in srgb, var(--accent-primary) 28%, var(--bg-secondary));
    width: min(100%, 1120px);
    margin-inline: auto;
    color: var(--lp-home-text);
  }

  .lp-home-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(3rem, 9vh, 5.5rem);
    padding: 0 0 1.75rem;
    border-bottom: 1px solid var(--lp-home-border);
  }

  .lp-home-brand {
    color: var(--lp-home-text);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .lp-home-brand-tld {
    color: var(--lp-home-accent);
  }

  .lp-home-header h1 {
    margin: 0;
    color: var(--lp-home-text);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 650;
    letter-spacing: -0.075em;
    line-height: 0.94;
  }

  .lp-home-search {
    padding-top: 1.25rem;
  }

  .lp-home-search .lp {
    width: 100%;
  }

  .lp-home-search .lp-search {
    position: sticky;
    z-index: 5;
    top: 0.75rem;
    display: flex;
    width: 100%;
    min-height: 4.25rem;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--lp-home-border);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--lp-home-surface) 94%, transparent);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(14px);
    transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }

  .lp-home-search .lp-search:focus-within,
  .lp-home-search .lp-search--focused {
    border-color: var(--lp-home-accent);
    background: var(--lp-home-surface-hover);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--lp-home-accent) 12%, transparent),
      0 1rem 2.5rem rgba(0, 0, 0, 0.2);
  }

  .lp-home-search .lp-search-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--lp-home-muted);
  }

  .lp-home-search .lp-search-input {
    min-width: 0;
    flex: 1;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--lp-home-text);
    font: 0.98rem var(--font-sans);
  }

  .lp-home-search .lp-search-input::placeholder {
    color: var(--lp-home-muted);
  }

  .lp-home-search .lp-search-clear {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--lp-home-muted);
    cursor: pointer;
    font: 1.2rem/1 var(--font-sans);
  }

  .lp-home-search .lp-search-clear:hover {
    color: var(--lp-home-text);
  }

  .lp-home-search .lp-search-hint {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.25rem;
  }

  .lp-home-search .lp-search-hint kbd {
    min-width: 1.4rem;
    padding: 0.15rem 0.3rem;
    border: 1px solid var(--lp-home-border);
    border-radius: 0.25rem;
    color: var(--lp-home-muted);
    font: 0.62rem var(--font-mono);
    text-align: center;
  }

  .lp-home-search .lp-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .lp-home-search .lp-row {
    display: flex;
    min-height: 11rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--lp-home-border);
    border-radius: 0.65rem;
    background: var(--lp-home-surface);
    color: var(--lp-home-text);
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease;
  }

  .lp-home-search .lp-row:hover,
  .lp-home-search .lp-row--active {
    border-color: var(--lp-home-accent-soft);
    background: var(--lp-home-surface-hover);
    transform: translateY(-1px);
  }

  .lp-home-search .lp-row-icon {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--lp-home-border);
    border-radius: 0.5rem;
    color: var(--lp-home-muted);
    transition: border-color 140ms ease, color 140ms ease, background-color 140ms ease;
  }

  .lp-home-search .lp-row-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .lp-home-search .lp-row--active .lp-row-icon,
  .lp-home-search .lp-row:hover .lp-row-icon {
    border-color: var(--lp-home-accent-soft);
    background: color-mix(in srgb, var(--lp-home-accent) 9%, transparent);
    color: var(--lp-home-accent);
  }

  .lp-home-search .lp-row-name {
    display: block;
    margin-top: 0.15rem;
    color: var(--lp-home-text);
    font-size: 0.94rem;
    font-weight: 650;
    transition: color 140ms ease;
  }

  .lp-home-search .lp-row--active .lp-row-name,
  .lp-home-search .lp-row:hover .lp-row-name {
    color: var(--lp-home-accent);
  }

  .lp-home-search .lp-row-desc {
    display: -webkit-box;
    overflow: hidden;
    margin-top: auto;
    color: var(--lp-home-secondary);
    font-size: 0.79rem;
    line-height: 1.48;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .lp-home-search .lp-row-cat {
    order: 3;
    color: var(--lp-home-muted);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }

  .lp-home-search .lp-empty {
    margin: 1rem 0;
    color: var(--lp-home-secondary);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .lp-home-search .lp-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .lp-home-header {
      gap: 3.5rem;
    }

    .lp-home-search .lp-search {
      top: 0.5rem;
      min-height: 3.75rem;
      padding-inline: 1rem;
    }

    .lp-home-search .lp-results {
      grid-template-columns: 1fr;
    }

    .lp-home-search .lp-row {
      min-height: 9.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-home-search .lp-search,
    .lp-home-search .lp-row,
    .lp-home-search .lp-row-icon,
    .lp-home-search .lp-row-name {
      transition: none;
    }
  }
</style>
