{
  "name": "unwrapped",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "version": "0.6.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run type-check:scripts && bun run lint && bun run format:check && bun run build && ROUTE_SMOKE_USE_EXISTING_DIST=1 bun run test",
    "og": "bun scripts/generate-og.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "diff": "^9.0.0",
    "lucide-solid": "^1.34.0",
    "smol-toml": "^1.8.0",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
