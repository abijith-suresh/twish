{
  "name": "unwrapped",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run type-check:scripts && bun run lint && bun run format:check && bun run build && bun run test",
    "og": "bun scripts/generate-og.ts",
    "icons": "bun scripts/generate-icons.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.3.1",
    "diff": "^9.0.0",
    "lucide-solid": "^1.42.0",
    "smol-toml": "^1.8.0",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "typescript": "6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
