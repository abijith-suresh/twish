{
  "name": "unwrapped",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "version": "0.6.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run type-check:scripts && bun run lint && bun run format:check && bun run build && ROUTE_SMOKE_USE_EXISTING_DIST=1 bun run test",
    "og": "bun scripts/generate-og.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^6.4.2",
    "diff": "^9.0.0",
    "lucide-solid": "^1.24.0",
    "smol-toml": "^1.7.0",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.28.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  }
}
